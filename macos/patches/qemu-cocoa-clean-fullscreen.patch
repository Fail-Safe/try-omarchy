diff --git a/ui/cocoa-clean-viewport.h b/ui/cocoa-clean-viewport.h
--- /dev/null
+++ b/ui/cocoa-clean-viewport.h
@@ -0,0 +1,12 @@
+#ifndef COCOA_CLEAN_VIEWPORT_H
+#define COCOA_CLEAN_VIEWPORT_H
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Multiples of 16 give integral logical heights at both 4/3 and 8/5. */
+static inline uint32_t cocoa_clean_viewport_height(uint32_t height,
+                                                  bool fullscreen, bool enabled)
+{
+    return enabled && fullscreen && height >= 608 ? height / 16 * 16 : height;
+}
+#endif
