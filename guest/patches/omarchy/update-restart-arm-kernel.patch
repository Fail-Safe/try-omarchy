+# No recognized package-owned marker means unknown, not an updated kernel.
+for kernel in /usr/lib/modules/*/vmlinuz /usr/lib/modules/*/modules.builtin; do
   if [[ -f $kernel ]] && pacman -Qo "$kernel" &>/dev/null; then
+    kernel_updated=true
