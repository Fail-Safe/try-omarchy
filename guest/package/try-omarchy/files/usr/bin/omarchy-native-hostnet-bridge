#!/usr/bin/python3
"""Mirror Mac Wi-Fi status into the Omarchy session over virtio-serial.

The host sends one JSON object per line on `dev.tryomarchy.hostnet`:

    {"type":"wifi","powered":true,"associated":true,"ssid":"HomeNet",...}

The guest advertises supported services in its refresh request. Bluetooth
actions use a bounded, allowlisted command path; Wi-Fi remains read-only.
Accepted wifi snapshots are written to
`$XDG_RUNTIME_DIR/try-omarchy-hostnet/wifi.json` for bar widgets and
`omarchy-host-wifi`.
"""

from __future__ import annotations

import json
import re
import socket
import uuid
import os
from pathlib import Path
import sys
import tempfile
import select
import time
from typing import Any


PORT = Path(os.environ.get("OMARCHY_HOSTNET_PORT", "/dev/virtio-ports/dev.tryomarchy.hostnet"))
REFRESH_LINE = b'{"type":"refresh","services":["wifi","bluetooth"]}\n'
MAX_LINE_BYTES = 65536
WIFI_KEYS = {
    "type",
    "powered",
    "associated",
    "ssid",
    "rssiDbm",
    "noiseDbm",
    "snrDb",
    "txRateMbps",
    "channel",
    "channelWidthMhz",
    "band",
    "security",
    "interface",
    "ssidUnavailable",
}


def log(message: str) -> None:
    print(f"omarchy-native-hostnet-bridge: {message}", file=sys.stderr, flush=True)


def state_dir() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        path = Path(runtime) / "try-omarchy-hostnet"
    else:
        path = Path.home() / ".cache" / "try-omarchy-hostnet"
    path.mkdir(parents=True, exist_ok=True)
    return path


def decode_wifi(line: bytes) -> dict[str, Any]:
    message = json.loads(line)
    if not isinstance(message, dict) or message.get("type") != "wifi":
        raise ValueError("host sent an invalid wifi message")
    optional_keys = {"ipAddress", "bssid", "phyMode", "networkMode", "bridgeInterface"}
    if not WIFI_KEYS <= set(message) or set(message) - WIFI_KEYS - optional_keys:
        raise ValueError("host wifi message has an unexpected schema")
    if not isinstance(message["powered"], bool) or not isinstance(message["associated"], bool):
        raise ValueError("wifi powered/associated must be booleans")
    if not isinstance(message["ssidUnavailable"], bool):
        raise ValueError("ssidUnavailable must be a boolean")
    for key in ("ssid", "band", "security", "interface", "ipAddress", "bssid", "phyMode", "networkMode", "bridgeInterface"):
        value = message.get(key)
        if value is not None and not isinstance(value, str):
            raise ValueError(f"{key} must be a string or null")
    if message.get("networkMode") not in (None, "nat", "bridged"):
        raise ValueError("invalid network mode")
    for key in ("rssiDbm", "noiseDbm", "snrDb", "channel", "channelWidthMhz"):
        value = message[key]
        if value is not None and type(value) is not int:
            raise ValueError(f"{key} must be an integer or null")
    if message["txRateMbps"] is not None and type(message["txRateMbps"]) not in (int, float):
        raise ValueError("txRateMbps must be a number or null")
    return message


def decode_bluetooth(message):
    if set(message) != {"type", "authorization", "powered", "devices"}:
        raise ValueError("unexpected Bluetooth schema")
    if message["authorization"] not in {"allowed", "denied", "restricted", "not-determined", "unavailable"}:
        raise ValueError("invalid Bluetooth authorization")
    if type(message["powered"]) is not bool or not isinstance(message["devices"], list) or len(message["devices"]) > 128:
        raise ValueError("invalid Bluetooth state")
    ids = set()
    for device in message["devices"]:
        if not isinstance(device, dict) or set(device) != {"id", "name", "connected", "kind"}:
            raise ValueError("invalid Bluetooth device")
        if not isinstance(device["id"], str) or not re.fullmatch(r"[0-9A-F]{2}(?::[0-9A-F]{2}){5}", device["id"]) or device["id"] in ids:
            raise ValueError("invalid Bluetooth device identity")
        ids.add(device["id"])
        if not isinstance(device["name"], str) or len(device["name"]) > 255 or type(device["connected"]) is not bool or device["kind"] not in {"audio", "input", "other"}:
            raise ValueError("invalid Bluetooth device details")
    return message


def decode_action(line):
    message = json.loads(line)
    if not isinstance(message, dict) or set(message) - {"type", "id", "action", "device"}:
        raise ValueError("invalid Bluetooth action")
    if message.get("type") != "bluetooth-action" or message.get("action") not in {"refresh", "settings", "connect", "disconnect"}:
        raise ValueError("unsupported Bluetooth action")
    if not isinstance(message.get("id"), str):
        raise ValueError("invalid Bluetooth action identity")
    uuid.UUID(message["id"])
    if message["action"] in {"connect", "disconnect"}:
        if not isinstance(message.get("device"), str) or not re.fullmatch(r"[0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}", message["device"]):
            raise ValueError("invalid Bluetooth address")
    elif "device" in message:
        raise ValueError("unexpected Bluetooth address")
    return message


def write_state(name, message):
    target = state_dir() / name
    payload = json.dumps(message, separators=(",", ":"), sort_keys=True).encode() + b"\n"
    fd, tmp_name = tempfile.mkstemp(prefix="wifi.", dir=str(target.parent))
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_name, target)
    finally:
        if os.path.exists(tmp_name):
            os.unlink(tmp_name)


def write_wifi(message):
    write_state("wifi.json", message)


def clear_wifi() -> None:
    target = state_dir() / "wifi.json"
    if target.exists():
        target.unlink()


def run() -> int:
    if not PORT.exists():
        log(f"missing {PORT}")
        return 1
    directory = state_dir()
    directory.chmod(0o700)
    socket_path = directory / "control.sock"
    if socket_path.exists():
        socket_path.unlink()
    pending = None
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(str(socket_path))
    socket_path.chmod(0o600)
    listener.listen(1)
    listener.setblocking(False)
    try:
        with PORT.open("r+b", buffering=0) as port:
            port.write(REFRESH_LINE)
            buffer = b""
            last_snapshot = {"wifi": time.monotonic(), "bluetooth": time.monotonic()}
            while True:
                ready, _, _ = select.select([port, listener], [], [], 1)
                now = time.monotonic()
                if pending and now - pending[2] > 15:
                    try:
                        pending[0].sendall(b'{"ok":false,"message":"Mac Bluetooth action timed out"}\n')
                    except OSError:
                        pass
                    pending[0].close()
                    pending = None
                for kind, timestamp in last_snapshot.items():
                    if now - timestamp >= 15:
                        (directory / (kind + ".json")).unlink(missing_ok=True)
                if listener in ready:
                    client, _ = listener.accept()
                    client.settimeout(0.5)
                    try:
                        line = b""
                        while b"\n" not in line and len(line) <= 1024:
                            chunk = client.recv(1024)
                            if not chunk:
                                break
                            line += chunk
                        if len(line) > 1024 or not line.endswith(b"\n") or pending:
                            raise ValueError("Bluetooth action unavailable or busy")
                        command = decode_action(line)
                        port.write(json.dumps(command).encode() + b"\n")
                        pending = (client, command["id"], now)
                    except (OSError, ValueError, KeyError, TypeError) as error:
                        try:
                            client.sendall(json.dumps({"ok": False, "message": str(error)}).encode() + b"\n")
                        except OSError:
                            pass
                        client.close()
                if port not in ready:
                    continue
                chunk = port.read(4096)
                if not chunk:
                    break
                buffer += chunk
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    if not line:
                        continue
                    if len(line) > MAX_LINE_BYTES:
                        raise ValueError("host line exceeds the size limit")
                    try:
                        message = json.loads(line)
                        if not isinstance(message, dict):
                            raise ValueError("invalid host message")
                        if message.get("type") == "bluetooth":
                            write_state("bluetooth.json", decode_bluetooth(message))
                            last_snapshot["bluetooth"] = time.monotonic()
                        elif message.get("type") == "bluetooth-result":
                            if set(message) != {"type", "id", "ok", "message"} or type(message["ok"]) is not bool or not isinstance(message["message"], str) or len(message["message"]) > 512:
                                raise ValueError("invalid Bluetooth result")
                            if pending and pending[1] == message["id"]:
                                try:
                                    pending[0].sendall(json.dumps(message).encode() + b"\n")
                                except OSError:
                                    pass
                                pending[0].close()
                                pending = None
                        else:
                            write_wifi(decode_wifi(line))
                            last_snapshot["wifi"] = time.monotonic()
                    except (ValueError, KeyError, TypeError) as error:
                        log(f"rejected host line: {error}")
                if len(buffer) > MAX_LINE_BYTES:
                    raise ValueError("host line exceeds the size limit")
    except (OSError, ValueError) as error:
        log(f"hostnet channel failed: {error}")
    finally:
        if pending:
            pending[0].close()
        listener.close()
        socket_path.unlink(missing_ok=True)
        clear_wifi()
        (directory / "bluetooth.json").unlink(missing_ok=True)
    log("host hostnet bridge disconnected")
    return 1


if __name__ == "__main__":
    sys.exit(run())
